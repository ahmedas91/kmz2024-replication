# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory. 

WRDS_USERNAME=jdoe

# Date window for the CRSP pull (the Goyal-Welch pull stores the full
# workbook untrimmed). Optional; defaults are set in src/settings.py.
START_DATE=1913-01-01
END_DATE=2024-12-31

# OOS estimation (src/run_estimation.py, src/run_variable_importance.py).
# Optional; defaults live in those modules. SAMPLE_END picks the last month
# of the estimation sample for every estimation-dependent artifact (grids,
# figures, summary table/plot). The default 2020-12 is the paper's sample end
# and writes the bare canonical filenames; any other value (e.g. 2024-12 for
# the updated-sample rerun) suffixes every such filename with the sample end
# (figure7_2024-12.png next to figure7.png), so both runs coexist and
# switching back and forth never recomputes what is already on disk (see
# src/sample_period.py and the README). Changing N_SEEDS or FIG11_N_SEEDS
# makes doit rerun the corresponding estimation task.
TRAIN_WINDOW=12
N_SEEDS=500
FIG11_N_SEEDS=100
BONDS_N_SEEDS=200
INTL_N_SEEDS=200
N_JOBS=-1
SAMPLE_END=2020-12

# Set to 1 to additionally export per-seed forecast / realized / strategy
# series at the anchor configuration (P = 12000, z = 1e3 plus ridgeless) to
# _data/forecasts_market{suffix}.parquet during `doit estimate` (the input
# the Nagel study needs). Off by default; adds a minute or two.
SAVE_FORECASTS=0
