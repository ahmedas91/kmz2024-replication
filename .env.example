# This file serves as an example of what your .env file should look like.
# Replace the variables defined here with those applicable on your own system.
# Then copy the contents into a file called ".env" and place it in project's
# root directory. 

WRDS_USERNAME=jdoe

# Date window for the CRSP pull (the Goyal-Welch pull stores the full
# workbook untrimmed). Optional; defaults are set in src/settings.py.
START_DATE=1913-01-01
END_DATE=2024-12-31

# OOS estimation grid (src/run_estimation.py; doit task `estimate`). Optional;
# defaults are set in src/run_estimation.py. SAMPLE_END pins the paper's
# 1930-01 to 2020-12 estimation sample; set 2024-12 for the updated-sample
# rerun. Changing N_SEEDS or SAMPLE_END makes doit rerun the estimate task.
TRAIN_WINDOW=12
N_SEEDS=50
N_JOBS=-1
SAMPLE_END=2020-12
